# =============================================================================
# PRISM — environment
#
# Copy to `.env.local` for local development. On Vercel, add the same keys
# under Project → Settings → Environment Variables.
#
# Every value here is optional. With none of them set, PRISM still builds,
# deploys and runs — it serves a seeded catalogue and hides the account-backed
# surfaces behind an explicit notice rather than breaking.
# =============================================================================

# -----------------------------------------------------------------------------
# YouTube Data API v3  —  powers search, trending, channels and comments
# -----------------------------------------------------------------------------
# Get one at https://console.cloud.google.com/apis/credentials
#   1. Create a project
#   2. Enable "YouTube Data API v3"
#   3. Create an API key
#   4. Restrict it to the YouTube Data API (and, in production, to your domain)
#
# Server-side only — never prefixed with NEXT_PUBLIC_, so it is never shipped
# to the browser.
#
# The default quota is 10,000 units/day. A search costs 100 units; a video
# lookup costs 1. You can list several comma-separated keys from different
# projects and PRISM will rotate to the next one when a key is exhausted.
YOUTUBE_API_KEY=

# -----------------------------------------------------------------------------
# Firebase  —  powers accounts, library, playlists and watch parties
# -----------------------------------------------------------------------------
# Get these at https://console.firebase.google.com
#   1. Create a project
#   2. Add a Web app (</> icon) and copy its config values below
#   3. Authentication → Sign-in method → enable "Email/Password" and "Google"
#   4. Firestore Database → Create database (production mode)
#   5. Deploy the rules in firestore.rules and the indexes in
#      firestore.indexes.json  (see the README for the exact commands)
#   6. Authentication → Settings → Authorized domains → add your Vercel domain
#
# These are public by design — Firebase web config is not a secret. Access is
# controlled by the Firestore security rules, not by hiding these values.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
# Absolute origin, no trailing slash. Used for canonical URLs, Open Graph tags,
# robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
