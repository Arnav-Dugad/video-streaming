# =============================================================================
# PRISM — environment
#
# Copy to `.env.local` for local development. On Vercel, add the same keys
# under Project → Settings → Environment Variables.
#
# Every value here is optional. With none of them set, PRISM still builds,
# deploys and runs — it serves a seeded catalogue and hides the account-backed
# surfaces behind an explicit notice rather than breaking.
# =============================================================================

# -----------------------------------------------------------------------------
# YouTube Data API v3  —  powers search, trending, channels and comments
# -----------------------------------------------------------------------------
# Get one at https://console.cloud.google.com/apis/credentials
#   1. Create a project
#   2. Enable "YouTube Data API v3"
#   3. Create an API key
#   4. Restrict it to the YouTube Data API (and, in production, to your domain)
#
# Server-side only — never prefixed with NEXT_PUBLIC_, so it is never shipped
# to the browser.
#
# The default quota is 10,000 units/day. A search costs 100 units; a video
# lookup costs 1. You can list several comma-separated keys from different
# projects and PRISM will rotate to the next one when a key is exhausted.
YOUTUBE_API_KEY=

# -----------------------------------------------------------------------------
# YouTube OAuth  —  optional; lets a viewer connect their own YouTube account
# -----------------------------------------------------------------------------
# Only needed for posting real comments, subscribing on YouTube itself, and
# importing a viewer's real subscriptions. Everything else — browsing, search,
# playback, and PRISM's own library — works without this.
#
# Set up at https://console.cloud.google.com/apis/credentials
#   1. Same project as the API key above
#   2. Configure the OAuth consent screen (External)
#   3. Add these scopes:
#        .../auth/youtube.readonly
#        .../auth/youtube.force-ssl
#   4. Create credentials -> OAuth client ID -> Web application
#   5. Authorised redirect URI (exactly, no trailing slash):
#        https://your-app.vercel.app/api/youtube/callback
#        http://localhost:3000/api/youtube/callback   (for local development)
#
# IMPORTANT: both scopes are classed by Google as *sensitive*. Until the
# project passes Google's verification review it is capped at 100 users, and
# each of them sees an "unverified app" warning during consent. That is why
# connecting is opt-in from settings rather than part of signing in.
#
# The client secret is server-side only — never prefixed with NEXT_PUBLIC_.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Firebase  —  powers accounts, library, playlists and watch parties
# -----------------------------------------------------------------------------
# Get these at https://console.firebase.google.com
#   1. Create a project
#   2. Add a Web app (</> icon) and copy its config values below
#   3. Authentication → Sign-in method → enable "Email/Password" and "Google"
#   4. Firestore Database → Create database (production mode)
#   5. Deploy the rules in firestore.rules and the indexes in
#      firestore.indexes.json  (see the README for the exact commands)
#   6. Authentication → Settings → Authorized domains → add your Vercel domain
#
# These are public by design — Firebase web config is not a secret. Access is
# controlled by the Firestore security rules, not by hiding these values.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# -----------------------------------------------------------------------------
# TURN relay  —  optional; makes room voice connect for everybody
# -----------------------------------------------------------------------------
# Voice in a watch party is peer to peer: the audio goes straight between two
# people and never touches a server of ours. Finding that direct path needs
# STUN, which is free and already configured.
#
# STUN is not always enough. Behind a symmetric NAT, a corporate firewall or
# some mobile carriers there is no direct path to find at all, and the only fix
# is to relay the audio through a third machine — that is what TURN is. Without
# one, a minority of pairs simply will not connect, and PRISM tells them so
# rather than spinning forever.
#
# ExpressTURN has the largest free tier and hands out plain static credentials,
# which is exactly the shape these three variables want. Metered, Twilio,
# Cloudflare Realtime and coturn on your own box all work too. Set all three or
# none; anything partial is ignored.
#
# The URL is the whole scheme, e.g.
#   turn:relay1.expressturn.com:3478
# Several may be listed, separated by commas. Adding the ?transport=tcp form
# alongside the plain one is worth it: some networks block UDP outright.
#
# The voice panel in any room has a self-test that reports whether a relay
# candidate can actually be gathered, which is the only way to know these are
# right without a second person on a hostile network.
#
# These reach the browser by necessity — a TURN credential has to. Issue
# short-lived ones from your provider rather than a permanent password.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
# Absolute origin, no trailing slash. Used for canonical URLs, Open Graph tags,
# robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
