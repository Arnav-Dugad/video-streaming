rules_version = '2';

/* =============================================================================
   PRISM — Firestore security rules

   Deploy with:  firebase deploy --only firestore:rules

   Principles:
     · A user can only ever read or write their own subtree under /users.
     · Playlists are owner-writable and readable by the owner, plus by anyone
       if explicitly marked public.
     · Rooms are readable by any signed-in user (that is what a shareable code
       is for), but only the host can drive playback. Everyone else may edit
       exactly one field: their own entry in the members map.
     · Nothing is world-writable, and no rule ever trusts a client-supplied uid.
   ============================================================================= */

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    /** The set of top-level fields this write actually changes. */
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---------------------------------------------------------------- users
    match /users/{uid} {
      allow read: if isSelf(uid);
      // The document's own uid field must match the caller — a client cannot
      // create a profile that claims to be somebody else.
      allow create: if isSelf(uid) && request.resource.data.uid == uid;
      allow update: if isSelf(uid) && request.resource.data.uid == resource.data.uid;
      allow delete: if isSelf(uid);

      // history / saved / likes / subscriptions — strictly private.
      match /{collection}/{docId} {
        allow read, write: if isSelf(uid)
          && collection in ['history', 'saved', 'likes', 'subscriptions'];
      }

      // Friendship is symmetric and stored on both sides, so adding somebody
      // means writing one document into *their* subtree. That write is allowed
      // only when it describes the caller — you can introduce yourself to
      // someone, you cannot forge an entry about a third party. Either side
      // may delete the edge, which is what makes removal mutual.
      match /friends/{friendUid} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid)
                              || (isSelf(friendUid)
                                  && request.resource.data.uid == request.auth.uid);
        allow delete: if isSelf(uid) || isSelf(friendUid);
      }

      // An invite lands in the recipient's own subtree — there is no shared
      // inbox to secure. Only an existing friend may write one, and only in
      // their own name.
      match /invites/{roomId} {
        allow read: if isSelf(uid);
        allow create, update: if signedIn()
                              && request.resource.data.fromUid == request.auth.uid
                              && exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid));
        allow delete: if isSelf(uid);
      }
    }

    // -------------------------------------------------------------- handles
    // A deliberately thin public directory: uid, handle, display name, photo —
    // the same four things that already appear next to somebody's name in a
    // room. It exists so a person can be found by handle without their email,
    // history or library being reachable. Each entry is writable only by the
    // account it names.
    match /handles/{handle} {
      allow read: if signedIn();
      // Create and update are split so a handle cannot be taken over: once an
      // entry exists, only the account it already names may rewrite it.
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSelf(resource.data.uid)
                    && request.resource.data.uid == resource.data.uid;
      allow delete: if isSelf(resource.data.uid);
    }

    // ------------------------------------------------------------ playlists
    match /playlists/{playlistId} {
      // `get` and `list` are split deliberately. Fetching one playlist by its
      // id is allowed for anything not marked private — that is what makes
      // "unlisted" mean anyone-with-the-link rather than owner-only. Listing
      // is owner-scoped, so an unlisted playlist can be opened but never
      // discovered by enumerating the collection.
      allow get: if resource.data.visibility != 'private'
                 || isSelf(resource.data.ownerUid);
      allow list: if isSelf(resource.data.ownerUid);

      allow create: if signedIn()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 120
                    && request.resource.data.visibility in ['private', 'unlisted', 'public'];

      // Ownership can never be transferred by an update.
      allow update: if isSelf(resource.data.ownerUid)
                    && request.resource.data.ownerUid == resource.data.ownerUid;

      allow delete: if isSelf(resource.data.ownerUid);
    }

    // ------------------------------------------------- smart playlists
    // Strictly private: a smart playlist is a rule over someone's own follow
    // list, so there is no sharing model to support and no reason for anyone
    // else to read one.
    match /smartPlaylists/{smartId} {
      allow read: if isSelf(resource.data.ownerUid);
      allow create: if signedIn()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 120
                    && request.resource.data.rule.channelIds is list
                    && request.resource.data.rule.channelIds.size() <= 10;
      allow update: if isSelf(resource.data.ownerUid)
                    && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isSelf(resource.data.ownerUid);
    }

    // ---------------------------------------------------------------- rooms
    match /rooms/{roomId} {
      // Any signed-in user may look a room up — the six-character code is the
      // access control, exactly like an unlisted link.
      allow read: if signedIn();

      allow create: if signedIn()
                    && request.resource.data.hostUid == request.auth.uid
                    && request.resource.data.code is string
                    && request.resource.data.code.size() == 6;

      // The host drives playback and may change the video.
      // Everyone else may only touch the members map — which is how joining
      // and leaving work — and can never seize the host role.
      // The host drives playback and the queue. Everyone else may only touch
      // the members map (joining and leaving) and the queue (suggesting
      // something to watch next) — and can never seize the host role.
      // A non-host writing `members` may only touch their *own* entry —
      // `changed().hasOnly(['members'])` alone would let any guest rewrite
      // the whole map and evict everybody.
      function onlyOwnMembership() {
        return request.resource.data.members.diff(resource.data.members)
                 .affectedKeys().hasOnly([request.auth.uid]);
      }

      function isMember() {
        return signedIn() && request.auth.uid in resource.data.members;
      }

      // `buffering` is how a guest says "I stalled, don't leave me behind".
      // Rules cannot diff a list element-wise, so this checks membership
      // rather than authorship: the worst a member can do is claim somebody
      // else is loading, and everyone here already holds the room code.
      allow update: if signedIn()
                    && request.resource.data.hostUid == resource.data.hostUid
                    && (
                         resource.data.hostUid == request.auth.uid
                         || (changed().hasOnly(['members']) && onlyOwnMembership())
                         || changed().hasOnly(['queue'])
                         || (changed().hasOnly(['members', 'queue']) && onlyOwnMembership())
                         || (changed().hasOnly(['buffering']) && isMember())
                       );

      allow delete: if isSelf(resource.data.hostUid);

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn()
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 500;
        // Messages are immutable; authors may delete their own.
        allow update: if false;
        allow delete: if isSelf(resource.data.uid);
      }

      /* ------------------------------ voice ------------------------------
         Two collections, both scoped to the room and both ephemeral.

         `voice` is presence: one document per participant, named by their uid,
         writable only by them. That naming is the whole authorisation model —
         nobody can announce somebody else, or hang them up.

         `signals` is a mailbox for WebRTC offers, answers and ICE candidates.
         An envelope may only be created in the sender's own name, and only a
         member may read the collection at all. Either endpoint may delete: the
         recipient deletes on read, which is what keeps a replayed offer from
         tearing down a working connection, and the sender clears anything
         never collected when they leave.

         Nothing here carries audio. The media goes peer to peer and never
         touches Firestore. */
      match /voice/{memberUid} {
        // `isMember()` cannot be used below this line: it reads
        // `resource.data.members`, and inside a subcollection `resource` is
        // the subcollection document, not the room. Reaching back for the room
        // with get() would bill a document read on every signalling message,
        // which for ICE candidates is a great many — and it would buy nothing,
        // because the room itself is already readable by any signed-in user.
        // The room id and the six-character code remain the access control.
        allow read: if signedIn();
        allow write: if isSelf(memberUid);
      }

      match /signals/{signalId} {
        // Reads are scoped by the addressee, which the client's query must
        // therefore also be scoped by — nobody can list somebody else's mail.
        allow read: if signedIn() && resource.data.to == request.auth.uid;
        allow create: if signedIn()
                      && request.resource.data.from == request.auth.uid
                      && request.resource.data.to is string
                      && request.resource.data.kind in ['offer', 'answer', 'candidate']
                      && request.resource.data.payload is string
                      && request.resource.data.payload.size() <= 20000;
        allow update: if false;
        allow delete: if signedIn()
                      && (resource.data.to == request.auth.uid
                          || resource.data.from == request.auth.uid);
      }

      match /reactions/{reactionId} {
        allow read: if signedIn();
        allow create: if signedIn()
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.emoji is string
                      && request.resource.data.emoji.size() <= 8;
        allow update: if false;
        allow delete: if isSelf(resource.data.uid);
      }
    }

    // Anything not matched above is denied.
  }
}
